{
  "name": "zimperiumBank",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:sit": "ENVFILE=.env.sit react-native run-android",
    "android:uat": "ENVFILE=.env.uat react-native run-android",
    "android:prod": "ENVFILE=.env.prod react-native run-android",
    "env:sit": "cp .env.sit .env",
    "env:uat": "cp .env.uat .env",
    "env:prod": "cp .env.prod .env",
    "ios": "react-native run-ios",
    "ios:sit": "ENVFILE=.env.sit react-native run-ios",
    "ios:uat": "ENVFILE=.env.uat react-native run-ios",
    "ios:prod": "ENVFILE=.env.prod react-native run-ios",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:ios": "rm -rf ios/build ~/Library/Developer/Xcode/DerivedData && cd ios && xcodebuild clean && cd ..",
    "clean": "rm -rf node_modules ios/Pods ios/Podfile.lock && npm install && cd ios && pod install && cd ..",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.86.3",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-config": "^1.7.2",
    "react-native-paper": "^5.15.4",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-vector-icons": "^10.3.0",
    "zdefend": "file:src/zDefend/zdefend-rn-multikey-zimperiumBank-5.10.85.tgz",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
